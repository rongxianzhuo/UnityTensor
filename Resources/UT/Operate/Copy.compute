#pragma kernel CSMain
#include "BaseFuncion.cginc"

uint dim;

StructuredBuffer<float> a;
StructuredBuffer<uint> a_stride;
RWStructuredBuffer<float> b;
StructuredBuffer<uint> b_stride;

[numthreads(512, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    const uint a_id = calculate_new_index(dim, id.x, b_stride, a_stride);
    b[id.x] = a[a_id];
}